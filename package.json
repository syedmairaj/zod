{
  "name": "zod-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Zod.ai - the reliability layer for AI-generated code",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @zod-ai/web",
    "build": "npm run build -w @zod-ai/web",
    "worker": "npm run start -w @zod-ai/worker-app",
    "worker:smoke": "npm run smoke -w @zod-ai/worker-app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@zod-ai/db": "*",
    "@zod-ai/github": "*",
    "@zod-ai/queue": "*",
    "@zod-ai/shared": "*",
    "@zod-ai/shared-types": "*",
    "@zod-ai/worker": "*",
    "pg": "^8.13.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
