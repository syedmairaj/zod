# Copy to apps/web/.env.local and fill in real values. Never commit the
# filled-in file. See SETUP.md for how to obtain each value.

# --- Postgres -----------------------------------------------------------
# Direct Postgres connection string (Supabase: Project Settings -> Database
# -> Connection string -> "URI", using the pooled/session connection).
# Used by @zod-ai/db for all privileged server-side reads/writes.
# Also required by the Milestone 3 worker (`npm run worker`).
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# --- Validation worker / scheduler (Milestone 3) -------------------------
# Long-running process: `npm run worker` (apps/worker). Not Next.js.
# WORKER_ID_PREFIX="worker"
# QUEUE_POLL_INTERVAL_MS="3000"
# RUN_LEASE_DURATION_MS="120000"
# RUN_HEARTBEAT_INTERVAL_MS="20000"
# RUN_MAX_ATTEMPTS="3"
# RUN_RETRY_BASE_DELAY_MS="5000"
# RUN_TIMEOUT_MS="60000"
# WORKER_SHUTDOWN_TIMEOUT_MS="30000"
# Safe placeholder modes for tests only: success | retryable_failure |
# non_retryable_failure | timeout | cancellation | crash
# WORKER_PLACEHOLDER_MODE="success"
# LOG_LEVEL="info"

# --- Supabase (Auth only) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Enable Email + GitHub + Google providers in the Supabase dashboard.
# OAuth client IDs/secrets are configured in Supabase (not in this file).
# GitHub OAuth App (human login) is separate from the repository GitHub App below.
# Redirect URLs must include ${NEXT_PUBLIC_APP_URL}/auth/callback — middleware
# does not forward arbitrary /?code= parameters to the callback.

# --- App ------------------------------------------------------------------
# Base URL this app is served from (used for auth/email redirects and the
# GitHub install callback). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- GitHub App -------------------------------------------------------------
# Create a GitHub App at https://github.com/settings/apps/new (see SETUP.md).
GITHUB_APP_ID="123456"
GITHUB_APP_SLUG="your-app-slug"
# PEM private key downloaded from the GitHub App settings page. Keep the
# literal "\n" line-break escapes if pasting as a single line.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# Webhook secret configured on the GitHub App's "Webhook secret" field.
GITHUB_APP_WEBHOOK_SECRET="generate-a-long-random-string"

# --- Internal secrets (generate locally, never share) ----------------------
# Signs the short-lived state token used in the GitHub App install flow.
# Generate with: openssl rand -hex 32
GITHUB_INSTALL_STATE_SECRET="generate-a-long-random-string"
# AES-256-GCM key for any cached sensitive value we persist (see
# packages/github/src/crypto.ts). Must decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="generate-a-32-byte-base64-key"
